{
  "name": "md-editor",
  "version": "2.0.0",
  "private": true,
  "description": "纸墨 · 安静的本地 Markdown 编辑器",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/launch.cjs dev",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/smoke.cjs",
    "build": "electron-vite build",
    "preview": "node scripts/launch.cjs preview",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "chokidar": "^6.0.0",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "codemirror": "^6.0.2",
    "dompurify": "3.4.18",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "@playwright/test": "^1.65.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4"
  },
  "build": {
    "icon": "assets/app-icon.ico",
    "appId": "cn.zhimo.editor",
    "productName": "纸墨",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "artifactName": "Zhimo-${version}-Windows-${arch}.${ext}"
  }
}
